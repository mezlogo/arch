# qemutest/justfile

disk := "disk.qcow"
size := "20"
memory := "4G"
cpus := "4"
ssh_port := "2022"
ssh_user := "root"
repo_root := parent_directory(justfile_directory())
repo_dest := "/root/arch"

ovmf_code := "/usr/share/edk2/x64/OVMF_CODE.4m.fd"
ovmf_vars := "/usr/share/edk2/x64/OVMF_VARS.4m.fd"
ovmf_vars_local := "OVMF_VARS.fd"

# Create a qcow2 disk. Default name: disk.qcow, default size: 20G.
create_disk name=disk size=size:
    qemu-img create -f qcow2 {{name}} {{size}}G

# Launch VM with UEFI, 4 CPU, 4G RAM, host network, and SSH port forward.
# Requires an ISO path as argument. Default disk: disk.qcow.
install_arch iso disk=disk:
    [ -f {{ovmf_vars_local}} ] || cp {{ovmf_vars}} {{ovmf_vars_local}}
    qemu-system-x86_64 \
        -enable-kvm \
        -m {{memory}} \
        -smp {{cpus}} \
        -cpu host \
        -drive if=pflash,format=raw,readonly=on,file={{ovmf_code}} \
        -drive if=pflash,format=raw,file={{ovmf_vars_local}} \
        -drive file={{disk}},format=qcow2,if=virtio \
        -cdrom {{iso}} \
        -nic user,hostfwd=tcp::{{ssh_port}}-:22 \
        -boot d

# Launch VM without ISO. Default disk: disk.qcow.
launch_arch disk=disk:
    [ -f {{ovmf_vars_local}} ] || cp {{ovmf_vars}} {{ovmf_vars_local}}
    qemu-system-x86_64 \
        -enable-kvm \
        -m {{memory}} \
        -smp {{cpus}} \
        -cpu host \
        -drive if=pflash,format=raw,readonly=on,file={{ovmf_code}} \
        -drive if=pflash,format=raw,file={{ovmf_vars_local}} \
        -drive file={{disk}},format=qcow2,if=virtio \
        -nic user,hostfwd=tcp::{{ssh_port}}-:22

# Remove stale host key for localhost:{{ssh_port}} and SSH into the VM.
ssh_arch user=ssh_user:
    -ssh-keygen -R "[localhost]:{{ssh_port}}"
    ssh -p {{ssh_port}} {{user}}@localhost

# Copy a custom local file/directory to the VM using scp.
# Examples:
#   just scp_dir ../my-dir /root/my-dir
#   just scp_dir ./config.yaml /root/config.yaml
scp_dir src dest=repo_dest user=ssh_user:
    scp -P {{ssh_port}} -r "{{src}}" "{{user}}@localhost:{{dest}}"

# rsync analog of scp_dir. Better for repeated syncs.
# Requires rsync on the host and VM. The first line installs it in the VM
# (default ssh_user is root; adjust if you changed it).
#
# Trailing slash semantics are rsync's:
#   rsync_dir src/ dest/   -> copy contents of src into dest
#   rsync_dir src  dest/   -> copy src directory itself into dest
#
# Add --delete to mirror exactly; omit it to be safe.
rsync_dir src dest=repo_dest user=ssh_user:
    rsync -avz --info=progress2 -e "ssh -p {{ssh_port}}" "{{src}}" "{{user}}@localhost:{{dest}}"

# Copy only git-tracked files to {{repo_dest}} on the VM.
# Uses `git archive HEAD` (tracked files only, .gitignore respected) compressed with gzip.
scp_repo user=ssh_user dest=repo_dest:
    cd "{{repo_root}}" && \
        git archive --format=tar HEAD | gzip -1 | \
        ssh -p {{ssh_port}} {{user}}@localhost 'mkdir -p "{{dest}}" && tar -xzf - -C "{{dest}}"'
